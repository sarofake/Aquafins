# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development, or paste the same keys
# into Vercel → Project → Settings → Environment Variables (Production,
# Preview and Development) before the first deploy.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Direct Postgres connection
#
# Used ONLY by the migration runner (build time + first request) to create the
# tables when they are missing. Never sent to the browser.
# Get it from: Project Settings → Database → Connection string → Session pooler
# ---------------------------------------------------------------------------
SUPABASE_DB_SESSION_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Split form (used when SUPABASE_DB_SESSION_URL is not set)
# SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
# SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
# SUPABASE_DB_PASSWORD=YOUR-DB-PASSWORD
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres

# ---------------------------------------------------------------------------
# Cloudinary — only needed for admin image uploads
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# ---------------------------------------------------------------------------
AQUAFINS_ADMIN_ID=admin
AQUAFINS_ADMIN_PASSWORD=choose-a-strong-password
AQUAFINS_ADMIN_PASSWORD_2=
# Any long random string — signs the admin session cookie
AQUAFINS_SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Fail the build instead of continuing when the DB connection fails
# MIGRATIONS_STRICT=true
